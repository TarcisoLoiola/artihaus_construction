      "sections": {
        "whoweare": {
          "title": "Who we are?",
          "subtitle": "Crafting Timeless Outdoor Living with ArtiHaus",
          "description": [
            "At ArtiHaus, we turn outdoor spaces into luxurious, functional extensions of your home. With over 20 years of expertise in hardscapes, landscapes, and now custom gunite pool construction, we specialize in building environments that bring lasting beauty, comfort, and value to your property.",
            "Whether it's an elegant gunite pool with PebbleTec finish, a stunning stone patio, a structural retaining wall, or a fully integrated outdoor living area—our team blends craftsmanship and creativity to transform your vision into reality.",
            "From the ground up, we handle every aspect:",
            "Excavation • Shotcrete • Plumbing • Electrical • Coping • Decking • Finishing",
            "Every project is built to endure—and designed to inspire."
          ],
          "imageURL": ""
        },
        "ourcommitment": {
          "title": "Our commitment to quality & excellence.",
          "subtitle": "",
          "description": [
            "At ArtiHaus, quality isn’t just a standard — it’s a mindset. What truly sets us apart is our hands-on, start-to-finish involvement in every project. From the initial design to the final detail, we stay personally engaged to ensure precision, accountability, and lasting results.",
            "We don't just build — we craft. Every stone placed, every pool poured, every feature installed reflects our passion for doing it right the first time."
          ]
        }
      }
